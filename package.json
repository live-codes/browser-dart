{
  "name": "@live-codes/dart-wasm",
  "version": "0.5.0",
  "description": "Run Dart and Flutter entirely in the browser, with no compilation server. The DartPad SDK — DDC, the analyzer and a subset of pub — behind a small promise-based API.",
  "keywords": [
    "dart",
    "flutter",
    "webassembly",
    "wasm",
    "compiler",
    "playground",
    "livecodes"
  ],
  "license": "MIT",
  "author": "Hatem Hosny",
  "type": "module",
  "homepage": "https://github.com/live-codes/browser-dart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/live-codes/browser-dart.git"
  },
  "bugs": {
    "url": "https://github.com/live-codes/browser-dart/issues"
  },
  "main": "./dist/dart-wasm.mjs",
  "module": "./dist/dart-wasm.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/dart-wasm.iife.js",
  "jsdelivr": "./dist/dart-wasm.iife.js",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dart-wasm.mjs",
      "default": "./dist/dart-wasm.mjs"
    },
    "./iife": "./dist/dart-wasm.iife.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "poc",
    "src",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fetch": "node scripts/fetch-sdk.mjs --variant all",
    "fetch:dart": "node scripts/fetch-sdk.mjs --variant dart",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "check-package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run check-package"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
